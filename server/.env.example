# DatAI Backend Configuration
# Add your Gemini API Key here or provide it via the web app settings modal
GEMINI_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash
HOST=0.0.0.0
PORT=8000

# CORS origins (comma-separated or * for all)
CORS_ORIGINS=*

# Optional: Path to compiled frontend client/dist (for unified fullstack mode)
# STATIC_DIR=../client/dist
