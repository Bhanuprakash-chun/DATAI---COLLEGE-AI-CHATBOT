{
  "name": "datai-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && python -m uvicorn main:app --reload --port 8000",
    "build:client": "cd client && npm run build",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "cd server && uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"
  }
}
